PORT=3001
NODE_ENV=development
# REQUIRED in production — the API refuses to start without it, and rejects known placeholders
# and anything under 32 chars. Forging a token is total compromise, not a single-account one:
# the payload is just { userId }, and admin is resolved from that userId.
#   generate with:  openssl rand -hex 32
JWT_SECRET=

# Comma-separated. Compiled into the esbuild bundle, so a wrong value here fails every API call
# as a CORS error that looks like "the backend is down".
CORS_ORIGINS=http://localhost:3000

# ── Robinhood Chain (Arbitrum Orbit L2, ETH gas) ──
# Testnet: 46630 / https://rpc.testnet.chain.robinhood.com  (faucet.testnet.chain.robinhood.com)
# Mainnet:  4663 / https://rpc.mainnet.chain.robinhood.com
# Leave EVM_RPC_URL / USDG_ADDRESS blank to use the verified defaults in shared/src/chain.ts.
EVM_CHAIN_ID=46630
EVM_RPC_URL=
EVM_EXPLORER_URL=

# Comma-separated failover RPCs, tried in order after EVM_RPC_URL. Optional but recommended:
# with only one endpoint, an outage stops deposit scanning and withdrawal reconciliation at
# once, and does it quietly — a failed scan is safe by design, so the keeper looks healthy and
# simply stops seeing deposits.
# Every URL is checked against EVM_CHAIN_ID at boot and the process REFUSES TO START on a
# mismatch: failing over onto the wrong chain scans foreign blocks and credits nobody.
EVM_RPC_FALLBACKS=

# Canonical USDG. Verified on-chain July 2026 — both 6 decimals, but decimals are still read
# from the contract at runtime and never trusted from config.
#   mainnet 4663:  0x5fc5360d0400a0fd4f2af552add042d716f1d168
#   testnet 46630: 0x915ef7c9f9f80a69e3be47a38ee0bb47607103ec   <- NOT the same address
USDG_ADDRESS=

# Platform hot wallet — 0x-prefixed 32-byte hex private key.
# MUST hold ETH for gas: gas is ETH, not USDG, so an unfunded wallet fails every withdrawal.
# This key controls all user funds. chmod 600, never log it, never `cat` it.
PLATFORM_WALLET_KEY=

# Deposit scanner
EVM_CONFIRMATIONS=20        # ~2s at 100ms blocks
EVM_SCAN_CHUNK_BLOCKS=2000
EVM_SCAN_INTERVAL_MS=60000  # 60s suits a public RPC; ~15000 on a dedicated endpoint
EVM_START_BLOCK=            # blank = start from head on first run (never scan from block 0)

# Optional: switches the oracle from the simulator to a live watch feed
WATCHCHARTS_API_KEY=

# Comma-separated wallet addresses allowed into /admin. FAILS CLOSED: empty = nobody.
# Lives here rather than in the DB so no route, injection or bad write can grant admin —
# promoting someone requires filesystem access to this box.
ADMIN_ADDRESSES=
